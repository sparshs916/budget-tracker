# Copy to .env for local runs. On Vercel, set these in Project Settings -> Environment Variables.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# From scripts/setup_secrets.py
APP_PASSWORD_HASH=
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Teller (teller.io dashboard)
TELLER_APP_ID=app_xxxxxxxx
TELLER_ENV=development
TELLER_CERT=
TELLER_PRIVATE_KEY=

# Optional
TIMEZONE=America/Los_Angeles
CREDIT_PURCHASES_ARE_POSITIVE=true
INITIAL_HISTORY_DAYS=365
RESYNC_WINDOW_DAYS=21
