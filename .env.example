# Copy to .env for local runs. On Vercel, set these in Project Settings -> Environment Variables
# (Vercel's Neon integration sets DATABASE_URL for you).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# From: python scripts/setup_secrets.py >> .env
APP_PASSWORD_HASH=
SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=

# Optional
TIMEZONE=America/Los_Angeles
INITIAL_HISTORY_DAYS=90
RESYNC_WINDOW_DAYS=21
INVERT_CREDIT_AMOUNTS=false
